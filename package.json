{
  "name": "louy",
  "version": "0.1.0",
  "private": true,
  "description": "L'Oûy — viewer 3D du relief LiDAR de la Wallonie, campagne par campagne",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "cameras:harvest": "node scripts/harvest-cameras.mjs",
    "provenance:verify": "node scripts/verify-provenance.ts",
    "sites:harvest": "node scripts/harvest-sites.mjs",
    "places:harvest": "node scripts/harvest-places.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@xstate/react": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Alan Hortz"
}
