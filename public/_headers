# En-têtes des fichiers statiques (Cloudflare Workers Static Assets).

# Fichiers au nom haché par la construction : immuables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Données récoltées : stables, rafraîchies à chaque déploiement.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Les listes qui désignent des fichiers lourds (vols de drone, images satellite, sports) changent à chaque ajout :
# revalidées à chaque visite, comme la liste des relevés — un téléphone qui gardait l'ancienne a manqué un vol.
/data/drone-flights.json
  ! Cache-Control
  Cache-Control: no-cache

/data/satellite.json
  ! Cache-Control
  Cache-Control: no-cache

/data/sports.json
  ! Cache-Control
  Cache-Control: no-cache

# Relevés 3D, séquences et images de la vue satellite : gros fichiers. Leur adresse porte l'empreinte de leur
# contenu (`?v=…`, posée à la construction) : le navigateur les garde un an sans jamais les redemander, et un
# fichier refait change d'adresse.
/scans/*
  Cache-Control: public, max-age=31536000, immutable

/satellite/*
  Cache-Control: public, max-age=31536000, immutable

# Leur liste, elle, change à chaque ajout : elle est revalidée à chaque visite.
/scans/index.json
  ! Cache-Control
  Cache-Control: no-cache

# Films du temps déjà tournés : des images fixes, gardées longtemps par le CDN et le navigateur.
# Un film retourné change de dossier, jamais de contenu.
/films/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Leur index, lui, est revalidé à chaque visite : un film retourné ou complété est vu aussitôt.
/films/*/index.json
  ! Cache-Control
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=604800

# La page elle-même est toujours revalidée : un déploiement est visible aussitôt.
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://trafiroutes.wallonie.be https://upload.wikimedia.org https://thumb.wikimedia.org; connect-src 'self' blob: https://geoservices.wallonie.be https://overpass-api.de https://overpass.private.coffee https://overpass.kumi.systems; worker-src 'self' blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
