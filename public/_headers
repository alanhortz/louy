# En-têtes des fichiers statiques (Cloudflare Workers Static Assets).

# Fichiers au nom haché par la construction : immuables.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Données récoltées : stables, rafraîchies à chaque déploiement.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Scans 3D : gros fichiers, remplacés rarement.
/scans/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Leur liste, elle, change à chaque ajout : elle est revalidée à chaque visite.
/scans/index.json
  ! Cache-Control
  Cache-Control: no-cache

# Films du temps déjà tournés : des images fixes, gardées longtemps par le CDN et le navigateur.
# Un film retourné change de dossier, jamais de contenu.
/films/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# Leur index, lui, est revalidé à chaque visite : un film retourné ou complété est vu aussitôt.
/films/*/index.json
  ! Cache-Control
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=604800

# La page elle-même est toujours revalidée : un déploiement est visible aussitôt.
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://trafiroutes.wallonie.be; connect-src 'self' blob: https://geoservices.wallonie.be https://overpass-api.de https://overpass.private.coffee https://overpass.kumi.systems; worker-src 'self' blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
